# Paths excluded from findings, relative to the repository root.
# Rule-specific suppressions belong next to the code as
#   //codex:ignore <rule-id> -- <reason>

# Generated code
**/*.pb.go
**/*.gen.go

# Vendored and third-party code
/vendor/
/third_party/

# Build output and caches
/bin/
/build/
/dist/
.codex_cache/

# Test fixtures contain intentionally vulnerable code
**/testdata/
